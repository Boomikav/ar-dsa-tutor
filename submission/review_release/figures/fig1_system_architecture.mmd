flowchart LR
    %% ========================================================================
    %% PILLAR I: CLIENT & SESSION LAYER
    %% ========================================================================
    subgraph COL1 ["<b>PILLAR I: CLIENT &amp; SESSION LAYER</b>"]
        direction TB
        M1["<b>Module 1: Learner Viewport &amp; UI</b><br/>• Viewport: Mobile WebXR canvas + spatial HUD<br/>• Interaction: Screen touch &amp; raycast hit-testing<br/>• Telemetry: Dispatches action, step key, latency"]
        
        M2["<b>Module 2: WebXR Session Core</b><br/>• Lifecycle: Single persistent XRSession across topics<br/>• Hot-Swapping: Retains WebGL &amp; GPU resources<br/>• <i>Boundary: Android ARCore unverified (simulation)</i>"]
        
        M3["<b>Module 3: Non-XR Fallback Engine</b><br/>• CANVAS_3D_FALLBACK: OrbitControls navigation<br/>• Alignment: Strict upright (+Y) spatial axis<br/>• Parity: Executes identical algorithms &amp; EGEA rules"]

        M1 -->|Session Config| M2
        M2 -.->|Fallback on Unsupported| M3
    end

    %% ========================================================================
    %% PILLAR II: ALGORITHM CORE & 3D ENGINE
    %% ========================================================================
    subgraph COL2 ["<b>PILLAR II: ALGORITHM CORE &amp; 3D ENGINE</b>"]
        direction TB
        M4["<b>Module 4: 5 Deterministic DSA Engines</b><br/>• BST: Left &lt; Node &lt; Right invariant reducer<br/>• Bubble Sort: Adjacent swaps • Binary: [low, mid, high]<br/>• BFS: FIFO queue • Stack: LIFO (depth limit 6)"]

        M5["<b>Module 5: Procedural 3D Visualizers</b><br/>• BST: Spherical nodes &amp; directed link cylinders<br/>• Bubble Sort: Scaled cylinder bars &amp; swap cues<br/>• BFS: Graph dock • Stack: Chamber &amp; slab meshes"]

        M6["<b>Module 6: Scene Assembler &amp; Sync</b><br/>• Scene Graph: Pure-render state mapping<br/>• Transitions: Smooth swap interpolation &amp; hits<br/>• Disposal: Clean GPU memory on algorithm swap"]

        M4 ==>|Invariant State| M5
        M5 -->|Mesh Scene Graph| M6
    end

    %% ========================================================================
    %% PILLAR III: EGEA ADAPTATION & HUD FEEDBACK
    %% ========================================================================
    subgraph COL3 ["<b>PILLAR III: EGEA ADAPTATION &amp; HUD FEEDBACK</b>"]
        direction TB
        M7["<b>Module 7: Event Adapter &amp; Pacing</b><br/>• Adapter: Monotonic k counter, 250ms debounce<br/>• canonicalizeStep: Normalizes retry step keys<br/>• EWMA Pacing: S_k = α·L_k + (1-α)S_{k-1} (α=0.3)"]

        M8["<b>Module 8: 6-Tier Scaffolding Engine</b><br/>• [1] HINT • [2] SLOWDOWN • [3] HIGHLIGHT<br/>• [4] WORKED • [5] PREREQ • [6] REDUCE<br/>• Latency: Pure Policy 7 μs | Pipeline 14 μs"]

        M9["<b>Module 9: Spatial AR Tutor HUD</b><br/>• ARTutorHUD: Real-time AR viewport overlay<br/>• Explainability: Grounded code &amp; conf (0.95)<br/>• <i>Offline: 18 Challenge / 12 Stress Suites (100%)</i>"]

        M7 ==>|Canonical Trace &amp; Pacing| M8
        M8 ==>|Policy Decision &amp; Rationale| M9
    end

